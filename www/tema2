<!-- Una función que devuelva el mayor de todos los números recibidos como parámetros: function mayor(): int. 
    Utiliza las funciones func_get_args(), etc... No puedes usar la función max(). -->

     <!-- Obtiene un array con los parámetros -->

    function mayor(){
        $mayor=0;
        for ($i=0; $i < func_num_args(); $i++){
            if (func_get_arg($i) > func_get_arg(++$i)){
                $mayor= func_get_arg($i);
            }    
        }
        return $mayor;
    }
    echo "El mayor número del array "+ func_get_args(); " es " + mayor();

